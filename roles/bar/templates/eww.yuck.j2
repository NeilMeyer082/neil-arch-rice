(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "30px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive true
  (bar-widget))

(defwidget bar-widget []
  (box :class "bar"
       :orientation "h"
    (label :text "Eww Bar - {{ selected_wm }}")))
