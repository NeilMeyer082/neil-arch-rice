/* Dynamic Color Palette Generated by Ansible */
* {
{% if selected_theme == 'catppuccin-latte' %}
    background:     #eff1f5;
    background-alt: #e6e9ef;
    foreground:     #4c4f69;
    selected:       #8839ef;
    border:         #ca9ee6;
{% elif selected_theme == 'nord' %}
    background:     #2e3440;
    background-alt: #3b4252;
    foreground:     #eceff4;
    selected:       #88c0d0;
    border:         #81a1c1;
{% elif selected_theme == 'gruvbox-dark' %}
    background:     #282828;
    background-alt: #3c3836;
    foreground:     #ebdbb2;
    selected:       #fabd2f;
    border:         #fe8019;
{% elif selected_theme == 'everforest-dark' %}
    background:     #2d353b;
    background-alt: #343f44;
    foreground:     #d3c6aa;
    selected:       #a7c080;
    border:         #83c092;
{% else %}
    /* Default: Catppuccin Mocha */
    background:     #1e1e2e;
    background-alt: #181825;
    foreground:     #cdd6f4;
    selected:       #cba6f7;
    border:         #b4befe;
{% endif %}
}
