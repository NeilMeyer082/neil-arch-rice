#!/usr/bin/env bash
# Auto-generated Rofi Power Menu via Ansible

chosen=$(echo -e "Lock\nLogout\nSuspend\nReboot\nShutdown" | rofi -dmenu -i -p "Power Menu:")

case "$chosen" in
    Lock)     hyprlock || swaylock || i3lock-color ;;
    Logout)   hyprctl dispatch exit 0 || swaymsg exit || i3-msg exit ;;
    Suspend)  systemctl suspend ;;
    Reboot)   systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac
