# Auto-generated Kitty Config via Ansible

font_family      {{ selected_mono_font | default('JetBrainsMono Nerd Font') }}
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        11.0

window_padding_width 12
confirm_os_window_close 0
enable_audio_bell no

# Color Palette Mapping
background {{ active_colors.bg }}
foreground {{ active_colors.fg }}
selection_background {{ active_colors.accent }}
selection_foreground {{ active_colors.bg }}

cursor {{ active_colors.accent }}
cursor_text_color {{ active_colors.bg }}

# Standard ANSI Colors
color0 {{ active_colors.bg }}
color1 {{ active_colors.red }}
color2 {{ active_colors.green }}
color3 {{ active_colors.yellow }}
color4 {{ active_colors.accent }}
color5 {{ active_colors.magenta }}
color6 {{ active_colors.cyan }}
color7 {{ active_colors.fg }}
