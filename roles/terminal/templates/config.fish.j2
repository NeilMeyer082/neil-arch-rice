if status is-interactive
    # Commands to run in interactive sessions can go here
    set -g fish_greeting ""

    {% if selected_prompt == 'starship' %}
    starship init fish | source
    {% endif %}

    if type -q zoxide
        zoxide init fish | source
    end

    if type -q eza
        alias ls="eza --icons"
        alias ll="eza -la --icons"
    end
end
